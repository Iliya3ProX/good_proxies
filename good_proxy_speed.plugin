def _parse_semver(v_str):
    parts = []
    for part in re.split(r"[^\d]+", str(v_str or "").strip()):
        if part.isdigit():
            parts.append(int(part))
    return tuple(parts) or (0, 0, 0)


def _mirror_source_group(url):
    host = (urlparse(str(url or "")).hostname or str(url or "")).strip().lower()
    if host in ("cdn.jsdelivr.net", "fastly.jsdelivr.net") or host.endswith(".jsdelivr.net"):
        return "jsdelivr"
    if host == "raw.githubusercontent.com":
        return "github_raw"
    if host == "ghproxy.net":
        return "ghproxy"
    return host


def _select_consensus_version(probes, min_groups=2):
    """Select the highest semver supported by at least min_groups independent mirror groups."""
    groups_by_ver = {}
    for item in probes or ():
        ver, url = item[0], item[1]
        if not ver:
            continue
        groups_by_ver.setdefault(ver, set()).add(_mirror_source_group(url))
    eligible = [ver for ver, groups in groups_by_ver.items() if len(groups) >= int(min_groups)]
    if not eligible:
        return None
    return max(eligible, key=_parse_semver)


def _select_consensus_payload(downloads, min_groups=2):
    """Group downloaded payloads by SHA-256 and require >= min_groups independent mirror groups."""
    groups = {}
    for base_url, host, data in downloads or ():
        digest = hashlib.sha256(data).hexdigest()
        entry = groups.setdefault(digest, {"bytes": data, "hosts": [], "groups": set(), "digest": digest})
        entry["hosts"].append(host)
        entry["groups"].add(_mirror_source_group(base_url))
    if not groups:
        return None, False
    consensus = max(groups.values(), key=lambda g: (len(g["groups"]), len(g["hosts"])))
    verified = len(consensus["groups"]) >= int(min_groups)
    return consensus, verified


def _atomic_write_bytes(target_file, data):
    tmp_path = f"{target_file}.tmp"
    try:
        with open(tmp_path, "wb") as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp_path, target_file)
    except Exception:
        try:
            if os.path.exists(tmp_path):
                os.remove(tmp_path)
        except Exception:
            pass
        raise


def _unwrap_class(cls_obj):
    if cls_obj is None:
        return None
    if hasattr(cls_obj, "getName"):
        try:
            if str(cls_obj.getName()) != "java.lang.Class":
                return cls_obj
        except Exception:
            pass
    if hasattr(cls_obj, "getClass"):
        try:
            jc = cls_obj.getClass()
            if hasattr(jc, "getName") and str(jc.getName()) != "java.lang.Class":
                return jc
        except Exception:
            pass
    if isinstance(cls_obj, type):
        for attr in ("__java_class__", "class_"):
            jc = getattr(cls_obj, attr, None)
            if jc is not None:
                return jc
    return cls_obj


def _resolve_class(name):
    cls = None
    try:
        cls = find_class(name)
    except Exception:
        pass
    if cls is None:
        try:
            cls = jclass("java.lang.Class").forName(name)
        except Exception:
            pass
    if cls is None:
        try:
            cls = _unwrap_class(jclass(name))
        except Exception:
            pass
    return _unwrap_class(cls)


def _speed_rows_base_offset(orig_count, current_count, main_rows=0):
    """Return row offset where speed rows start: orig+7 if good_proxy is active, else orig."""
    orig = int(orig_count or 0)
    cur = int(current_count or 0)
    return orig + 7 if (cur >= orig + 7 or int(main_rows or 0) >= 7) else orig


def _log(msg):
    _android_log(f"[GoodProxySpeed] {msg}")


def _shared_config():
    return jclass("org.telegram.messenger.SharedConfig")


def _get_proxy_controller():
    for name in (
        "com.exteragram.messenger.proxy.ProxyController",
        "org.telegram.messenger.ProxyController",
    ):
        cls = None
        try:
            cls = jclass(name)
        except Exception:
            try:
                cls = _resolve_class(name)
            except Exception:
                cls = None
        if cls is None:
            continue
        try:
            inst = getattr(cls, "getInstance", None)
            if callable(inst):
                res = inst()
                if res is not None:
                    return res
            get_method = getattr(cls, "getMethod", None)
            if callable(get_method):
                m = get_method("getInstance")
                if m is not None:
                    res = m.invoke(None)
                    if res is not None:
                        return res
        except Exception:
            continue
    return None


def _get_proxy_list(SC, proxy_controller=None):
    if proxy_controller is not None:
        try:
            getter = getattr(proxy_controller, "getProxyList", None)
            if callable(getter):
                res = getter()
                if res is not None:
                    return res
        except Exception:
            pass
    try:
        return getattr(SC, "proxyList", None) or get_private_field(SC, "proxyList")
    except Exception:
        return None


def _proxy_list_size(proxy_list):
    if proxy_list is None:
        return None
    try:
        size_fn = getattr(proxy_list, "size", None)
        if callable(size_fn):
            return int(size_fn())
    except Exception:
        pass
    try:
        return len(proxy_list)
    except Exception:
        return None


def _proxy_list_item(proxy_list, index):
    try:
        get_fn = getattr(proxy_list, "get", None)
        if callable(get_fn):
            return get_fn(int(index))
    except Exception:
        pass
    try:
        return proxy_list[int(index)]
    except Exception:
        return None


def _notify(kind, text):
    msg = str(text or "")
    def _show():
        try:
            if kind == "error":
                BulletinHelper.show_error(msg)
            elif kind == "success":
                BulletinHelper.show_success(msg)
            else:
                BulletinHelper.show_info(msg)
        except Exception as e:
            _log(f"_notify error: {e}")
    run_on_ui_thread(_show)


def _show_modal_alert(title, message, button_text="Понятно"):
    def _show():
        try:
            from ui.alert import AlertDialogBuilder
            fragment = get_last_fragment()
            context = fragment.getParentActivity() if fragment is not None else None
            if context is None:
                raise RuntimeError("Activity unavailable")
            builder = AlertDialogBuilder(context)
            builder.set_title(str(title))
            builder.set_message(str(message))
            builder.set_positive_button(str(button_text), lambda d, _w: d.dismiss())
            builder.show()
        except Exception:
            _notify("info", f"{title}\n\n{message}")
    run_on_ui_thread(_show)


def _format_speed_mbps(total_bytes, elapsed):
    seconds = max(0.001, float(elapsed or 0.001))
    speed_mbps = max(0.0, float(total_bytes or 0)) / seconds / 1_000_000.0
    if speed_mbps < 1.0:
        label = f"{speed_mbps:.1f} МБ/с"
    else:
        label = f"{speed_mbps:.2f} МБ/с"
    return speed_mbps, label


_PROXY_SPEED_NAME_PREFIX_RE = re.compile(r"^\s*\d+(?:[.,]\d+)?\s*МБ/с\s*[·|—-]\s*", re.IGNORECASE)
_PROXY_SPEED_NAME_ONLY_RE = re.compile(r"^\s*\d+(?:[.,]\d+)?\s*МБ/с\s*$", re.IGNORECASE)


def _proxy_speed_name_text(current_name, display_name, host, port, speed_text):
    base_name = ""
    for candidate in (current_name, display_name):
        base = str(candidate or "").strip()
        base = _PROXY_SPEED_NAME_PREFIX_RE.sub("", base, count=1).strip()
        if base and not _PROXY_SPEED_NAME_ONLY_RE.fullmatch(base):
            base_name = base
            break
    if not base_name:
        safe_host = str(host or "").strip()
        try:
            port_value = int(port or 0)
        except Exception:
            port_value = 0
        base_name = f"{safe_host}:{port_value}" if safe_host and port_value > 0 else safe_host
    speed = str(speed_text or "").strip()
    return f"{speed} · {base_name}" if speed and base_name else speed or base_name


def _parse_speed_message_id(value):
    text = str(value or "").strip()
    try:
        query = parse_qs(urlparse(text).query)
        for name in ("message_id", "msg_id"):
            for candidate in query.get(name, []):
                if str(candidate).strip().isdigit() and int(candidate) > 0:
                    return int(candidate)
    except Exception:
        pass
    path = text.split("?", 1)[0].rstrip("/")
    match = re.search(r"(\d+)\s*$", path)
    if not match:
        return 0
    try:
        result = int(match.group(1))
        return result if result > 0 else 0
    except Exception:
        return 0


def _speed_file_chunks(requested_bytes, file_size, chunk_bytes=512 * 1024):
    try:
        target = min(max(0, int(requested_bytes)), max(0, int(file_size)))
        chunk = max(1, int(chunk_bytes))
    except Exception:
        return 0, []
    return target, list(range(0, target, chunk))


def _proxy_key(host, port, secret="", proxy_type="mtproto"):
    p_type = str(proxy_type or "mtproto").lower()
    if p_type == "web" or int(port or 0) == 0:
        return f"web:{str(host or '').strip().lower()}:{str(secret or '').strip()}"
    return f"mtproto:{str(host or '').strip().lower()}:{int(port)}:{str(secret or '').strip()}"


def _proxy_item_values(item):
    if item is None:
        return "", 0, "", ""
    settings = None
    try:
        settings = get_private_field(item, "settings") or getattr(item, "settings", None)
    except Exception:
        pass

    def get_val(method_name, field_name, default=""):
        target = settings if settings is not None else item
        try:
            m = getattr(target, method_name, None)
            if callable(m):
                return m()
        except Exception:
            pass
        try:
            val = getattr(target, field_name, None)
            if val is not None:
                return val
        except Exception:
            pass
        try:
            val = get_private_field(target, field_name)
            if val is not None:
                return val
        except Exception:
            pass
        return default

    try:
        p_type = str(get_val("getType", "type", "") or "").split(".")[-1].upper()
        addr = str(get_val("getAddress", "address", "") or "").strip()
        port = int(get_val("getPort", "port", 0) or 0)
        secret = str(get_val("getSecret", "secret", "") or "").strip()
        return addr, port, secret, p_type
    except Exception:
        return "", 0, "", ""


def _proxy_settings_for_item(item, host, port, secret, proxy_type):
    try:
        settings = get_private_field(item, "settings") or getattr(item, "settings", None)
        if settings is not None:
            return settings
    except Exception:
        pass
    type_name = str(proxy_type or "").split(".")[-1].upper()
    if type_name not in ("MTPROTO", "SOCKS5", "WEB"):
        type_name = "MTPROTO" if str(secret or "").strip() else "SOCKS5"
    try:
        ProxySettings = jclass("org.telegram.utils.proxy.ProxySettings")
        ProxyType = jclass("org.telegram.utils.proxy.ProxySettings$Type")
        builder = ProxySettings.builder()
        builder.setType(getattr(ProxyType, type_name))
        builder.setAddress(str(host))
        builder.setPort(int(port))
        if type_name in ("MTPROTO", "WEB"):
            builder.setSecret(str(secret or ""))
        return builder.build()
    except Exception:
        return None


def _proxy_settings_fields(settings):
    if settings is None:
        return None
    try:
        p_type = str(getattr(settings, "getType", lambda: "")() or "").split(".")[-1].upper()
        addr = str(getattr(settings, "getAddress", lambda: "")() or "").strip()
        port = int(getattr(settings, "getPort", lambda: 0)() or 0)
        secret = str(getattr(settings, "getSecret", lambda: "")() or "").strip()
        return {"type": p_type, "address": addr, "port": port, "secret": secret}
    except Exception:
        return None


def _apply_icon(cell, tv_name, icon_name):
    """Иконка в TextSettingsCell (аналогично good_proxy.plugin)."""
    try:
        tv = get_private_field(cell, tv_name)
        ctx = cell.getContext()
        res_id = ctx.getResources().getIdentifier(icon_name, "drawable", ctx.getPackageName())
        if not tv or not res_id:
            return
        Theme = jclass("org.telegram.ui.ActionBar.Theme")
        drawable = ctx.getResources().getDrawable(res_id).mutate()
        drawable.setColorFilter(jclass("android.graphics.PorterDuffColorFilter")(
            Theme.getColor(Theme.key_windowBackgroundWhiteGrayIcon),
            jclass("android.graphics.PorterDuff").Mode.MULTIPLY
        ))
        is_rtl = jclass("org.telegram.messenger.LocaleController").isRTL
        tv.setCompoundDrawablesWithIntrinsicBounds(None, None, drawable, None) if is_rtl else tv.setCompoundDrawablesWithIntrinsicBounds(drawable, None, None, None)
        tv.setCompoundDrawablePadding(jclass("org.telegram.messenger.AndroidUtilities").dp(16))
    except Exception:
        pass


def _jbox_bool(v):
    """Боксинг Python bool в java.lang.Boolean (для setResult boolean-методов)."""
    try:
        return JBoolean.valueOf(bool(v))
    except Exception:
        return bool(v)


def _jbox_long(v):
    """Боксинг Python int в java.lang.Long (для setResult long-методов)."""
    try:
        return JLong.valueOf(int(v))
    except Exception:
        return int(v)


_SPEED_CLICK_TAG_KEY = 0x5A475002


class GoodProxySpeedPlugin(BasePlugin):
    def on_plugin_load(self):
        try:
            self._unloaded = False
            self._unload_event = threading.Event()
            self._hooks = []
            self._update_timer = None
            self._speed_base_offsets = {}
            self._wrapped_list_views = set()
            self._speed_context = None
            self._bulk_speed_busy = False
            self._bulk_speed_state = None
            plugin = self

            _log(f"Plugin v{__version__} loading...")

            # Меню: Скорость текущего прокси
            try:
                self.add_menu_item(MenuItemData(
                    menu_type=MenuItemType.MAIN_MENU,
                    text="Скорость текущего прокси",
                    on_click=self._on_check_current_proxy_speed,
                    icon="msg2_speed",
                    priority=100,
                ))
            except Exception as e:
                _log(f"add MAIN_MENU error: {e}")

            # Кнопки теста рядами списка ProxyListActivity: при активном
            # good_proxy.plugin начинаются с orig+7, при автономной работе —
            # с orig (base_offset вычисляется динамически в SpeedCountHook).
            try:
                AdapterCls = _resolve_class("org.telegram.ui.ProxyListActivity$ListAdapter")
                ProxyListActivityCls = _resolve_class("org.telegram.ui.ProxyListActivity")
                if AdapterCls and ProxyListActivityCls:
                    def _speed_orig_count(param):
                        act = get_private_field(param.thisObject, "this$0")
                        return int(get_private_field(act, "rowCount") or 0) if act else None

                    def _speed_base_for_act(act, orig):
                        if int(getattr(sys, "_good_proxy_active_rows", 0) or 0) >= 7:
                            return orig + 7
                        if act is None:
                            return orig
                        rel_offset = plugin._speed_base_offsets.get(id(act), 0)
                        return orig + rel_offset

                    def _lv_already_wrapped(lv):
                        marker = id(plugin)
                        try:
                            if lv.getTag(_SPEED_CLICK_TAG_KEY) == marker:
                                return True
                        except Exception:
                            pass
                        return id(lv) in plugin._wrapped_list_views

                    def _mark_lv_wrapped(lv):
                        marker = id(plugin)
                        try:
                            lv.setTag(_SPEED_CLICK_TAG_KEY, marker)
                        except Exception:
                            pass
                        plugin._wrapped_list_views.add(id(lv))

                    class SpeedCountHook(MethodHook):
                        def after_hooked_method(self, param):
                            if getattr(plugin, "_unloaded", False):
                                return
                            orig = _speed_orig_count(param)
                            if orig is None:
                                return
                            current = int(param.getResult())
                            main_rows = int(getattr(sys, "_good_proxy_active_rows", 0) or 0)
                            base = _speed_rows_base_offset(orig, current, main_rows=main_rows)
                            act = get_private_field(param.thisObject, "this$0")
                            if act is not None:
                                plugin._speed_base_offsets[id(act)] = base - orig
                            param.setResult(Integer(base + 3))

                    class SpeedViewTypeHook(MethodHook):
                        def before_hooked_method(self, param):
                            if getattr(plugin, "_unloaded", False):
                                return
                            if (orig := _speed_orig_count(param)) is not None:
                                act = get_private_field(param.thisObject, "this$0")
                                base = _speed_base_for_act(act, orig)
                                rel = int(param.args[0]) - base
                                if 0 <= rel < 3:
                                    param.setResult(Integer(0 if rel == 0 else 1))

                    class SpeedBindHook(MethodHook):
                        def before_hooked_method(self, param):
                            if getattr(plugin, "_unloaded", False):
                                return
                            if (orig := _speed_orig_count(param)) is not None:
                                act = get_private_field(param.thisObject, "this$0")
                                base = _speed_base_for_act(act, orig)
                                rel = int(param.args[1]) - base
                                if 0 <= rel < 3:
                                    param.setResult(None)

                        def after_hooked_method(self, param):
                            if getattr(plugin, "_unloaded", False):
                                return
                            if (orig := _speed_orig_count(param)) is None:
                                return
                            act = get_private_field(param.thisObject, "this$0")
                            base = _speed_base_for_act(act, orig)
                            rel = int(param.args[1]) - base
                            if rel not in (1, 2):
                                return
                            holder = param.args[0]
                            if holder is None:
                                return
                            cell = holder.itemView
                            try:
                                if rel == 1:
                                    cell.setText("Замер скорости активного прокси", True)
                                    _apply_icon(cell, "textView", "msg2_speed")
                                elif rel == 2:
                                    cell.setText("Сгенерировать тестовый файл", True)
                                    _apply_icon(cell, "textView", "msg_download")
                            except Exception as e:
                                _log(f"speed bind row error: {e}")

                    class SpeedEnabledHook(MethodHook):
                        def before_hooked_method(self, param):
                            if getattr(plugin, "_unloaded", False):
                                return
                            holder = param.args[0]
                            if holder is None:
                                return
                            if (orig := _speed_orig_count(param)) is not None:
                                act = get_private_field(param.thisObject, "this$0")
                                base = _speed_base_for_act(act, orig)
                                rel = int(holder.getAdapterPosition()) - base
                                if 0 <= rel < 3:
                                    param.setResult(_jbox_bool(True))

                    class SpeedIdHook(MethodHook):
                        def before_hooked_method(self, param):
                            if getattr(plugin, "_unloaded", False):
                                return
                            if (orig := _speed_orig_count(param)) is not None:
                                act = get_private_field(param.thisObject, "this$0")
                                base = _speed_base_for_act(act, orig)
                                rel = int(param.args[0]) - base
                                if 0 <= rel < 3:
                                    param.setResult(_jbox_long(-200 - (base - orig + rel)))

                    class SpeedClickHook(MethodHook):
                        def after_hooked_method(self, param):
                            if getattr(plugin, "_unloaded", False):
                                return
                            act = param.thisObject
                            try:
                                lv = get_private_field(act, "listView")
                                if lv is None:
                                    return
                                if _lv_already_wrapped(lv):
                                    return
                                old_l = get_private_field(lv, "onItemClickListener")

                                class SpeedPMClickListener(dynamic_proxy(jclass("org.telegram.ui.Components.RecyclerListView$OnItemClickListener"))):
                                    def __init__(self):
                                        super().__init__()

                                    def onItemClick(self, view, pos):
                                        if getattr(plugin, "_unloaded", False):
                                            return old_l.onItemClick(view, pos) if old_l else None
                                        orig = int(get_private_field(act, "rowCount") or 0)
                                        base = _speed_base_for_act(act, orig)
                                        rel = pos - base
                                        if rel < 0 or rel >= 3:
                                            return old_l.onItemClick(view, pos) if old_l else None
                                        if rel == 1:
                                            plugin._on_check_current_proxy_speed(None)
                                        elif rel == 2:
                                            plugin._on_generate_speed_file_click(None)

                                lv.setOnItemClickListener(SpeedPMClickListener())
                                _mark_lv_wrapped(lv)
                            except Exception as e:
                                _log(f"speed row click hook error: {e}")

                    def _register_hook(method, hook):
                        handle = self.hook_method(method, hook)
                        if handle is not None:
                            self._hooks.append(handle)

                    adapter_hooked = False
                    for m in AdapterCls.getDeclaredMethods():
                        if m.getName() == "getItemCount":
                            _register_hook(m, SpeedCountHook())
                            adapter_hooked = True
                        elif m.getName() == "getItemViewType":
                            _register_hook(m, SpeedViewTypeHook())
                        elif m.getName() == "onBindViewHolder" and len(m.getParameterTypes()) == 2:
                            _register_hook(m, SpeedBindHook())
                        elif m.getName() == "isEnabled" and len(m.getParameterTypes()) == 1:
                            _register_hook(m, SpeedEnabledHook())
                        elif m.getName() == "getItemId" and len(m.getParameterTypes()) == 1:
                            _register_hook(m, SpeedIdHook())

                    click_hooked = False
                    for m in ProxyListActivityCls.getDeclaredMethods():
                        if m.getName() == "createView":
                            _register_hook(m, SpeedClickHook())
                            click_hooked = True

                    if adapter_hooked and click_hooked:
                        _log("Speed rows hooked into ProxyListActivity list")
                    else:
                        _log(f"Speed rows hook incomplete: adapter={adapter_hooked} click={click_hooked}")
            except Exception as e:
                _log(f"speed proxy list hook error: {e}")

            try:
                self.add_menu_item(MenuItemData(
                    menu_type=MenuItemType.DRAWER_MENU,
                    text="Скорость текущего прокси",
                    on_click=self._on_check_current_proxy_speed,
                    icon="msg2_speed",
                    priority=100,
                ))
            except Exception as e:
                _log(f"add DRAWER_MENU error: {e}")

            _log(f"Plugin v{__version__} loaded successfully")
            self._check_plugin_update(manual=False)
        except Exception as e:
            _log(f"on_plugin_load error: {e}")

    def on_plugin_unload(self):
        self._unloaded = True
        ev = getattr(self, "_unload_event", None)
        if ev is not None:
            try:
                ev.set()
            except Exception:
                pass
        timer = getattr(self, "_update_timer", None)
        if timer is not None:
            try:
                timer.cancel()
            except Exception:
                pass
            self._update_timer = None
        ctx = getattr(self, "_speed_context", None)
        if ctx is not None:
            try:
                self._finish_speed_context(ctx, error="Плагин выгружен.")
            except Exception:
                self._speed_context = None
        for handle in list(getattr(self, "_hooks", ())):
            try:
                self.unhook_method(handle)
            except Exception:
                pass
        if hasattr(self, "_hooks"):
            self._hooks.clear()
        if hasattr(self, "_speed_base_offsets"):
            self._speed_base_offsets.clear()
        if hasattr(self, "_wrapped_list_views"):
            self._wrapped_list_views.clear()
        _log("Plugin unloaded")

    def create_settings(self) -> list:
        try:
            from ui.settings import Divider, Header, Selector, Switch, Text
        except Exception as e:
            _log(f"create_settings unavailable: {e}")
            return []

        rows = []

        try:
            rows.append(Header(text="Параметры замера скорости"))
            try:
                rows.append(Selector(
                    key="speed_test_chunks",
                    text="Размер тестового файла",
                    default=2,
                    items=["2 МБ", "5 МБ", "10 МБ"],
                    icon="msg2_speed",
                ))
            except Exception as e:
                _log(f"create_settings Selector error: {e}")

            # «Сгенерировать тестовый файл» перенесено в меню выбора прокси
            rows.append(Switch(
                key="speed_test_set_proxy_name",
                text="Записывать скорость в название",
                default=True,
                subtext="Добавляет замеренную скорость прямо в имя прокси в клиенте.",
                icon="msg_edit",
            ))
            rows.append(Switch(
                key="auto_update_plugin",
                text="Автообновление плагина",
                default=True,
                subtext="Проверять обновления плагина на GitHub при старте.",
                icon="msg_retry",
            ))
            try:
                rows.append(Divider())
            except Exception:
                pass
            rows.append(Header(text="Справка и диагностика"))
            rows.append(Text(
                text="Инструкция",
                subtext="Как работает замер скорости и TCP Window Warmup.",
                icon="msg_info",
                on_click=self._on_show_guide_click,
            ))
            rows.append(Text(
                text="Проверить обновление плагина",
                subtext=f"Текущая версия Good Proxy Speed: v{__version__}",
                icon="msg_retry",
                on_click=self._on_check_update_click,
            ))
        except Exception as e:
            _log(f"create_settings error: {e}")

        return rows

    def _on_check_update_click(self, _view=None):
        _notify("info", "Проверяем наличие обновлений Good Proxy Speed…")
        self._check_plugin_update(manual=True)

    def _check_plugin_update(self, manual=False):
        """Проверяет наличие новой версии плагина на GitHub и обновляет файл."""
        if not manual:
            try:
                enabled = self.get_setting("auto_update_plugin", True)
                if isinstance(enabled, str):
                    enabled = enabled.strip().lower() not in ("0", "false", "no", "off", "")
                else:
                    enabled = bool(enabled)
            except Exception:
                enabled = True
            if not enabled:
                return

        def task():
            if getattr(self, "_unloaded", False):
                return
            current_ver_tuple = _parse_semver(__version__)
            candidates = []  # (version, base_url, host, data)
            errors = []
            for base_url in PLUGIN_UPDATE_URLS:
                if getattr(self, "_unloaded", False):
                    return
                host = urlparse(base_url).hostname or base_url
                sep = "&" if "?" in base_url else "?"
                url = f"{base_url}{sep}t={int(time.time())}"
                try:
                    req = urllib.request.Request(
                        url,
                        headers={
                            "User-Agent": f"GoodProxySpeed/{__version__} (Android Updater)",
                            "Cache-Control": "no-cache",
                            "Pragma": "no-cache",
                        },
                    )
                    with urllib.request.urlopen(req, timeout=10) as resp:
                        code = resp.getcode()
                        if code == 200:
                            data = resp.read(2 * 1024 * 1024)
                            header_sample = data[:3000].decode("utf-8", errors="ignore")
                            m = re.search(r'__version__\s*=\s*["\']([^"\']+)["\']', header_sample)
                            if m:
                                cand_version = m.group(1).strip()
                                candidates.append((cand_version, base_url, host, data))
                            else:
                                errors.append(f"{host}: версия не распознана")
                        else:
                            errors.append(f"{host}: HTTP {code}")
                except Exception as e:
                    err_msg = f"{type(e).__name__}: {str(e)[:80]}"
                    errors.append(f"{host}: {err_msg}")
                    _log(f"Check update mirror {url} failed: {e}")
                    continue

            if not candidates:
                if manual:
                    details = "\n".join(errors[:3]) if errors else "Зеркала не вернули данных."
                    _notify("error", f"Не удалось проверить обновления Good Proxy Speed:\n{details}")
                return

            highest_remote_version = _select_consensus_version(
                [(v, u, h) for v, u, h, _ in candidates], min_groups=2
            )
            if not highest_remote_version:
                any_newer = any(_parse_semver(v) > current_ver_tuple for v, _, _, _ in candidates)
                if any_newer:
                    _log("Speed plugin update rejected: fewer than 2 independent mirror groups agree on version")
                    if manual:
                        _notify("error", "Обновление Good Proxy Speed отклонено: версия не подтверждена минимум на двух независимых зеркалах.")
                elif manual:
                    _notify("info", f"У вас установлена последняя версия Good Proxy Speed (v{__version__}).")
                return

            if _parse_semver(highest_remote_version) <= current_ver_tuple:
                if manual:
                    _notify("info", f"У вас установлена последняя версия Good Proxy Speed (v{__version__}).")
                return

            matching_downloads = [
                (base_url, host, data)
                for ver, base_url, host, data in candidates
                if ver == highest_remote_version
            ]
            consensus, verified = _select_consensus_payload(matching_downloads, min_groups=2)
            if not consensus or not verified:
                _log(f"Speed plugin update rejected: SHA-256 consensus failed for v{highest_remote_version}")
                if manual:
                    _notify("error", "Обновление Good Proxy Speed отклонено: не удалось подтвердить SHA-256 минимум на двух независимых зеркалах.")
                return

            try:
                target_file = None
                try:
                    if "__file__" in globals() and __file__ and os.path.isfile(__file__):
                        target_file = __file__
                except Exception:
                    pass
                if not target_file:
                    from file_utils import get_plugins_dir
                    target_file = os.path.join(str(get_plugins_dir()), "good_proxy_speed.plugin")
                _atomic_write_bytes(target_file, consensus["bytes"])
                _log(f"Good Proxy Speed successfully updated to v{highest_remote_version} at {target_file} "
                     f"(groups={sorted(consensus['groups'])})")
                _notify("success", f"Плагин Good Proxy Speed обновлен до v{highest_remote_version}!\nПерезапустите Telegram для применения изменений.")
            except Exception as e:
                _log(f"Failed to write updated plugin file: {e}")
                if manual:
                    _notify("error", f"Сбой записи файла плагина: {e}")

        run_on_queue(task, PLUGINS_QUEUE)

    def _on_show_guide_click(self, _view=None):
        guide = (
            "Good Proxy Speed — замер реальной скорости:\n\n"
            "1. Подготовка:\n"
            "Откройте меню выбора прокси и нажмите «Сгенерировать тестовый файл» (внизу списка). "
            "Плагин создаст txt-файл со случайным содержимым и отправит его в ваше «Избранное». "
            "ID файла привяжется автоматически.\n\n"
            "2. Замер:\n"
            "• В меню выбора прокси: «Замер скорости активного прокси» — замеряет выделенный прокси.\n"
            "• «Скорость текущего прокси» в главном меню — замеряет активное соединение.\n\n"
            "3. Технология TCP Window Warmup:\n"
            "Первый чанк (512 КБ) скачивается для прогрева соединения и раскрытия окна перегрузки TCP (cwnd). "
            "Секундомер включается со второго чанка, обеспечивая чистый и точный замер без ограничений RTT."
        )
        run_on_ui_thread(lambda: _show_modal_alert("Инструкция Good Proxy Speed", guide, "Понятно"))

    def _on_generate_speed_file_click(self, _view=None):
        _notify("info", "Генерирую тестовый файл...")
        run_on_queue(self._do_generate_speed_file, PLUGINS_QUEUE)

    def _do_generate_speed_file(self):
        try:
            size_idx = int(self.get_setting("speed_test_chunks", 2))
            sizes = [2 * 1024 * 1024, 5 * 1024 * 1024, 10 * 1024 * 1024]
            if size_idx < 0 or size_idx >= len(sizes):
                size_idx = 2
            base_size = sizes[size_idx]

            # Нулевой паттерн и ровные размеры иногда не проходят upload —
            # генерируем обычный .txt со случайными буквами и «плавающим»
            # размером (база ± до 512 КБ, не меньше 1 МБ), без подписи
            target_size = base_size + random.randint(-512 * 1024, 512 * 1024)
            target_size = max(1024 * 1024, target_size)
            letters = (string.ascii_letters + string.digits).encode("ascii")

            ApplicationLoader = jclass("org.telegram.messenger.ApplicationLoader")
            cache_dir = ApplicationLoader.applicationContext.getCacheDir().getAbsolutePath()
            file_path = os.path.join(cache_dir, "speed_test_asset.txt")
            # старый файл чистим перед созданием нового, но НЕ сразу после
            # отправки: upload асинхронный и читает файл с диска после вызова
            try:
                if os.path.exists(file_path):
                    os.remove(file_path)
            except Exception:
                pass

            chunk_size = 64 * 1024
            with open(file_path, "wb") as f:
                written = 0
                while written < target_size:
                    to_write = min(chunk_size, target_size - written)
                    buf = bytearray(os.urandom(to_write))
                    for i in range(to_write):
                        buf[i] = letters[buf[i] % len(letters)]
                    f.write(bytes(buf))
                    written += to_write

            actual_mb = os.path.getsize(file_path) / (1024.0 * 1024.0)
            label = f"{actual_mb:.1f} МБ"

            peer_id = get_user_config().getClientUserId()
            send_document(peer_id, file_path)

            self.set_setting("speed_test_message_id", "")
            time.sleep(1.2)
            found_id = self._find_speed_test_message_in_saved(target_size)
            if found_id > 0:
                self.set_setting("speed_test_message_id", str(found_id))
                run_on_ui_thread(lambda: BulletinHelper.show_success(f"Тестовый файл ({label}) создан и отправлен в «Избранное»!"))
            else:
                run_on_ui_thread(lambda: BulletinHelper.show_success(f"Тестовый файл ({label}) отправлен в «Избранное»."))
        except Exception as e:
            _log(f"generate speed file error: {e}")
            run_on_ui_thread(lambda: BulletinHelper.show_error(f"Ошибка создания файла: {e}"))

    def _find_speed_test_message_in_saved(self, expected_size=0):
        try:
            UserConfig = jclass("org.telegram.messenger.UserConfig")
            ConnectionsManager = jclass("org.telegram.tgnet.ConnectionsManager")
            RequestDelegate = jclass("org.telegram.tgnet.RequestDelegate")
            cm = ConnectionsManager.getInstance(UserConfig.selectedAccount)

            req = TLRPC.TL_messages_getHistory()
            req.peer = TLRPC.TL_inputPeerSelf()
            req.offset_id = 0
            req.offset_date = 0
            req.add_offset = 0
            req.limit = 20
            req.max_id = 0
            req.min_id = 0
            req.hash = 0

            result = {"msg_id": 0}
            done = threading.Event()

            class HistoryDelegate(dynamic_proxy(RequestDelegate)):
                def run(_delegate, response, error):
                    if response is not None:
                        msgs = getattr(response, "messages", None)
                        if msgs is not None:
                            try:
                                n = int(msgs.size())
                                items = [msgs.get(i) for i in range(n)]
                            except Exception:
                                items = list(msgs)
                            for m in items:
                                media = getattr(m, "media", None)
                                doc = getattr(media, "document", None) if media else None
                                if doc is not None:
                                    doc_size = int(getattr(doc, "size", 0) or 0)
                                    msg_text = str(getattr(m, "message", "") or "")
                                    file_name = ""
                                    try:
                                        attrs = getattr(doc, "attributes", None)
                                        if attrs is not None:
                                            try:
                                                n_attrs = int(attrs.size())
                                                attr_items = [attrs.get(i) for i in range(n_attrs)]
                                            except Exception:
                                                attr_items = list(attrs)
                                            for a in attr_items:
                                                if "Filename" in type(a).__name__:
                                                    file_name = str(getattr(a, "file_name", "") or "")
                                                    break
                                    except Exception:
                                        file_name = ""
                                    is_match = (
                                        "speed_test_asset" in file_name
                                        or "Good Proxy" in msg_text
                                        or "speed_test_asset" in msg_text
                                        or (expected_size > 0 and abs(doc_size - expected_size) < 4096)
                                    )
                                    if is_match:
                                        result["msg_id"] = int(getattr(m, "id", 0) or 0)
                                        break
                    done.set()

            delegate = HistoryDelegate()
            cm.sendRequest(req, delegate, 2)
            done.wait(timeout=6.0)
            return result["msg_id"]
        except Exception as e:
            _log(f"_find_speed_test_message_in_saved error: {e}")
            return 0

    def _get_speed_test_message_id(self):
        try:
            raw = self.get_setting("speed_test_message_id", "")
            mid = _parse_speed_message_id(raw)
            if mid > 0:
                return mid
        except Exception:
            pass
        try:
            # размер файла теперь «плавающий» — ищем по имени speed_test_asset.*
            found_id = self._find_speed_test_message_in_saved(0)
            if found_id > 0:
                self.set_setting("speed_test_message_id", str(found_id))
                return found_id
        except Exception as e:
            _log(f"auto discover speed test message failed: {e}")
        return 0

    def _speed_name_updates_enabled(self):
        try:
            val = self.get_setting("speed_test_set_proxy_name", True)
            if isinstance(val, str):
                return val.strip().lower() not in ("", "0", "false", "no")
            return bool(val)
        except Exception:
            return True

    def _set_native_proxy_speed_name(self, record, speed_text):
        if not self._speed_name_updates_enabled():
            return None
        try:
            controller = _get_proxy_controller()
            item = record.get("item")
            if controller is None or item is None:
                return False
            current_name = getattr(item, "title", None) or get_private_field(item, "title") or ""
            target_name = _proxy_speed_name_text(
                current_name, record.get("display_host", ""), record.get("host", ""), record.get("port", 0), speed_text
            )
            for m_name in ("setProxyName", "setProxyTitle", "renameProxy"):
                method = getattr(controller, m_name, None)
                if callable(method):
                    try:
                        method(item, target_name)
                        return True
                    except Exception:
                        pass
            try:
                set_private_field(item, "title", target_name)
                return True
            except Exception:
                pass
            return False
        except Exception as e:
            _log(f"set proxy speed name error: {e}")
            return False

    def _save_native_proxy_speed_names(self):
        try:
            controller = _get_proxy_controller()
            saver = getattr(controller, "saveProxyList", None) if controller else None
            if callable(saver):
                saver()
                return True
            return False
        except Exception:
            return False

    def _refresh_proxy_name_ui(self):
        def _refresh():
            try:
                fragment = get_last_fragment()
                if fragment and "ProxyListActivity" in str(fragment.getClass().getName()):
                    lv = get_private_field(fragment, "listView")
                    if lv:
                        adapter = lv.getAdapter()
                        if adapter:
                            adapter.notifyDataSetChanged()
            except Exception:
                pass
        run_on_ui_thread(_refresh)

    def _speed_context_is_active(self, ctx):
        try:
            with ctx["lock"]:
                return bool(ctx.get("active", False)) and getattr(self, "_speed_context", None) is ctx
        except Exception:
            return False

    def _safe_tg_error(self, error):
        if error is None:
            return "неизвестная ошибка"
        try:
            text = getattr(error, "text", None)
            if text:
                return str(text)[:180]
        except Exception:
            pass
        return type(error).__name__

    def _on_check_current_proxy_speed(self, context=None):
        if getattr(self, "_unloaded", False):
            return
        if getattr(self, "_bulk_speed_busy", False) or getattr(self, "_speed_context", None) is not None:
            return _notify("info", "Тест скорости уже выполняется.")
        try:
            chunks_idx = int(self.get_setting("speed_test_chunks", 2))
        except Exception:
            chunks_idx = 2
        sizes = [2 * 1024 * 1024, 5 * 1024 * 1024, 10 * 1024 * 1024]
        labels = ["2 МБ", "5 МБ", "10 МБ"]
        if chunks_idx < 0 or chunks_idx >= len(sizes):
            chunks_idx = 2
        _notify("info", f"Скачиваю тестовый файл через Telegram ({labels[chunks_idx]})…")
        run_on_queue(self._do_check_current_speed, PLUGINS_QUEUE)

    def _do_check_current_speed(self):
        ctx = None
        try:
            if getattr(self, "_unloaded", False):
                return
            if getattr(self, "_bulk_speed_busy", False):
                return _notify("info", "Пакетная проверка скорости уже выполняется.")
            if getattr(self, "_speed_context", None) is not None:
                return _notify("info", "Тест скорости уже выполняется.")

            message_id = self._get_speed_test_message_id()
            if message_id <= 0:
                return _notify(
                    "error",
                    "Тестовый файл не найден. В меню выбора прокси нажмите иконку загрузки — тестовый файл отправится в «Избранное».",
                )

            SC = _shared_config()
            is_enabled = getattr(SC, "proxyEnabled", False) or (
                hasattr(SC, "isProxyEnabled") and SC.isProxyEnabled()
            )
            if not is_enabled:
                return _notify("error", "Тест не запущен: прокси сейчас отключён. Сначала включите прокси в клиенте.")

            proxy_controller = _get_proxy_controller()
            cp = None
            if proxy_controller is not None:
                try:
                    getter = getattr(proxy_controller, "getCurrentProxy", None)
                    if callable(getter):
                        cp = getter()
                except Exception:
                    pass
            if cp is None:
                cp = getattr(SC, "currentProxy", None)
            if cp is None:
                return _notify("error", "Тест не запущен: не удалось определить активный прокси.")

            host, port, _secret, _proxy_type = _proxy_item_values(cp)
            if not host or not port:
                return _notify("error", "Не удалось определить адрес активного прокси для теста скорости.")
            proxy_settings = _proxy_settings_for_item(cp, host, port, _secret, _proxy_type)

            try:
                chunks_idx = int(self.get_setting("speed_test_chunks", 2))
            except Exception:
                chunks_idx = 2
            sizes = [2 * 1024 * 1024, 5 * 1024 * 1024, 10 * 1024 * 1024]
            labels = ["2 МБ", "5 МБ", "10 МБ"]
            if chunks_idx < 0 or chunks_idx >= len(sizes):
                chunks_idx = 2

            UserConfig = jclass("org.telegram.messenger.UserConfig")
            ConnectionsManager = jclass("org.telegram.tgnet.ConnectionsManager")
            RequestDelegate = jclass("org.telegram.tgnet.RequestDelegate")
            cm = ConnectionsManager.getInstance(UserConfig.selectedAccount)
            try:
                current_user_id = int(get_user_config().getClientUserId())
            except Exception:
                current_user_id = 0

            ctx = {
                "active": True,
                "lock": threading.RLock(),
                "delegates": [],
                "request_ids": [],
                "cm": cm,
                "connections_class": ConnectionsManager,
                "host": str(host),
                "port": int(port),
                "proxy_item": cp,
                "secret": str(_secret or ""),
                "proxy_type": str(_proxy_type or ""),
                "proxy_settings": proxy_settings,
                "message_id": int(message_id),
                "current_user_id": current_user_id,
                "requested_bytes": sizes[chunks_idx],
                "size_label": labels[chunks_idx],
                "started": 0.0,
                "pending": 0,
                "total_bytes": 0,
                "file_size": 0,
                "target_bytes": 0,
                "timer": None,
            }
            self._speed_context = ctx
            timer = threading.Timer(
                90.0,
                lambda c=ctx: self._finish_speed_context(c, error="Таймаут ответа Telegram; тест остановлен."),
            )
            timer.daemon = True
            ctx["timer"] = timer
            timer.start()

            request = TLRPC.TL_messages_getMessages()
            request.id.add(Integer(int(message_id)))
            plugin = self

            class MessageDelegate(dynamic_proxy(RequestDelegate)):
                def run(_delegate, response, error):
                    plugin._on_speed_message_response(ctx, response, error)

            delegate = MessageDelegate()
            with ctx["lock"]:
                if not ctx.get("active", False):
                    return
                ctx["delegates"].append(delegate)
                req_id = cm.sendRequest(request, delegate, 2)
                if req_id is not None:
                    ctx["request_ids"].append(int(req_id))
        except Exception as e:
            _log(f"do check current speed error: {e}")
            if ctx is not None:
                self._finish_speed_context(ctx, error=f"Ошибка подготовки теста: {type(e).__name__}")
            else:
                _notify("error", f"Ошибка подготовки теста: {type(e).__name__}")

    def _on_speed_message_response(self, ctx, response, error):
        if not self._speed_context_is_active(ctx):
            return
        if error is not None:
            return self._finish_speed_context(ctx, error=f"Не удалось получить тестовый файл: {self._safe_tg_error(error)}")
        try:
            messages = getattr(response, "messages", None)
            if not messages or messages.size() == 0:
                return self._finish_speed_context(ctx, error="Сообщение с файлом не найдено в Telegram.")
            message = messages.get(0)
            media = getattr(message, "media", None)
            doc = getattr(media, "document", None) if media else None
            if doc is None:
                return self._finish_speed_context(ctx, error="В сообщении нет Telegram-документа.")

            file_size = int(getattr(doc, "size", 0) or 0)
            dc_id = int(getattr(doc, "dc_id", 0) or 0)
            doc_id = int(getattr(doc, "id", 0) or 0)
            access_hash = int(getattr(doc, "access_hash", 0) or 0)
            file_ref = getattr(doc, "file_reference", None)

            target_bytes, offsets = _speed_file_chunks(ctx["requested_bytes"], file_size)
            if target_bytes <= 0 or not offsets:
                return self._finish_speed_context(ctx, error="Размер файла равен нулю.")

            loc = TLRPC.TL_inputDocumentFileLocation()
            loc.id = doc_id
            loc.access_hash = access_hash
            loc.file_reference = file_ref
            loc.thumb_size = ""

            chunk_size = 512 * 1024
            ctx["file_size"] = file_size
            ctx["target_bytes"] = target_bytes
            ctx["document_dc_id"] = dc_id
            ctx["pending"] = len(offsets)
            ctx["total_bytes"] = 0
            ctx["started"] = time.monotonic()

            cm = ctx["cm"]
            conn_class = ctx["connections_class"]
            try:
                conn_type = int(getattr(conn_class, "ConnectionTypeDownload", 2))
            except Exception:
                conn_type = 2
            try:
                conn_type_2 = int(getattr(conn_class, "ConnectionTypeDownload2", conn_type))
            except Exception:
                conn_type_2 = conn_type
            plugin = self
            RequestDelegate = jclass("org.telegram.tgnet.RequestDelegate")

            for idx, offset in enumerate(offsets):
                req = TLRPC.TL_upload_getFile()
                req.location = loc
                req.offset = int(offset)
                req.limit = chunk_size
                req.precise = False
                req.cdn_supported = False
                c_type = conn_type if idx % 2 == 0 else conn_type_2

                class ChunkDelegate(dynamic_proxy(RequestDelegate)):
                    def run(_delegate, chunk_resp, chunk_err):
                        plugin._on_speed_chunk_response(ctx, chunk_resp, chunk_err)

                delegate = ChunkDelegate()
                with ctx["lock"]:
                    if not ctx.get("active", False):
                        break
                    ctx["delegates"].append(delegate)
                    req_id = cm.sendRequest(req, delegate, None, None, 0, int(dc_id), int(c_type), True)
                    ctx["request_ids"].append(int(req_id))
        except Exception as e:
            _log(f"prepare speed download error: {e}")
            return self._finish_speed_context(ctx, error=f"Сбой загрузки: {type(e).__name__}")

    def _byte_buffer_length(self, response):
        try:
            payload = getattr(response, "bytes", None)
            if payload is None:
                return 0
            for name in ("limit", "length", "remaining"):
                val = getattr(payload, name, None)
                if callable(val):
                    return max(0, int(val()))
                if val is not None:
                    return max(0, int(val))
            return max(0, len(payload))
        except Exception:
            return 0

    def _on_speed_chunk_response(self, ctx, response, error):
        received = 0
        if response is not None:
            received = self._byte_buffer_length(response)
            try:
                free = getattr(response, "freeResources", None)
                if callable(free):
                    free()
            except Exception:
                pass
        if not self._speed_context_is_active(ctx):
            return
        if error is not None:
            return self._finish_speed_context(ctx, error=f"Ошибка Telegram: {self._safe_tg_error(error)}")
        if received <= 0:
            return self._finish_speed_context(ctx, error="Telegram вернул пустой фрагмент.")

        with ctx["lock"]:
            if not ctx.get("active", False):
                return
            ctx["total_bytes"] += int(received)
            ctx["completed"] = int(ctx.get("completed", 0)) + 1
            ctx["pending"] = max(0, int(ctx.get("pending", 0)) - 1)
            # TCP Window Warmup: отбрасываем чанк 0
            if ctx.get("completed") == 1 and int(ctx.get("pending", 0)) > 0:
                ctx["warmup_time"] = time.monotonic()
                ctx["warmup_bytes"] = int(received)
            done = ctx["pending"] == 0
            total_bytes = int(ctx["total_bytes"])
            warmup_time = ctx.get("warmup_time")
            warmup_bytes = int(ctx.get("warmup_bytes", 0))
            completed = int(ctx.get("completed", 0))
        if done:
            if warmup_time is not None and completed > 1 and int(ctx.get("target_bytes", 0)) > 512 * 1024:
                elapsed = max(0.001, time.monotonic() - warmup_time)
                measured_bytes = max(1, total_bytes - warmup_bytes)
            else:
                elapsed = max(0.001, time.monotonic() - float(ctx.get("started", time.monotonic())))
                measured_bytes = total_bytes
            return self._finish_speed_context(ctx, total_bytes=measured_bytes, elapsed=elapsed)

    def _finish_speed_context(self, ctx, total_bytes=None, elapsed=None, error=None):
        try:
            with ctx["lock"]:
                if not ctx.get("active", False):
                    return
                ctx["active"] = False
                timer = ctx.get("timer")
                r_ids = list(ctx.get("request_ids", []))
                cm = ctx.get("cm")
            if getattr(self, "_speed_context", None) is ctx:
                self._speed_context = None
            if timer:
                try:
                    timer.cancel()
                except Exception:
                    pass
            if error:
                for rid in r_ids:
                    try:
                        cm.cancelRequest(int(rid), True)
                    except Exception:
                        pass
                return _notify("error", f"Тест скорости не завершён: {str(error)[:180]}")

            speed_mbps, speed_text = _format_speed_mbps(total_bytes, elapsed)
            # Ручная проверка 06.11 (SP1): функции нужен record с ключом "item",
            # а раньше передавался сам ctx (ключ "proxy_item") — item всегда был
            # None и скорость НИКОГДА не попадала в имя прокси
            speed_record = {
                "item": ctx.get("proxy_item"),
                "display_host": ctx.get("host", ""),
                "host": ctx.get("host", ""),
                "port": ctx.get("port", 0),
            }
            host_label = ctx.get("host")

            def _apply_name_and_notify():
                name_updated = False
                try:
                    name_updated = bool(self._set_native_proxy_speed_name(speed_record, speed_text))
                    if name_updated:
                        self._save_native_proxy_speed_names()
                        self._refresh_proxy_name_ui()
                except Exception as ui_err:
                    _log(f"apply proxy speed name on UI thread error: {ui_err}")
                msg = f"{host_label}: {speed_text}."
                if name_updated:
                    msg += " Скорость записана в имя прокси."
                _notify("success", msg)

            run_on_ui_thread(_apply_name_and_notify)
            return True
        except Exception as e:
            _log(f"finish speed context error: {e}")

    def _on_check_all_proxy_speeds_click(self, _view=None):
        # Замер скорости работает только через активный прокси клиента; пакетный режим
        # потребовал бы переключать активный прокси для каждого узла — не реализован.
        # Честное сообщение вместо ложного отчёта об успехе.
        return _notify(
            "info",
            "Пакетный замер недоступен, используйте одиночный: включите нужный прокси и нажмите «Проверить скорость».",
        )

    def _run_bulk_speed_test(self):
        # Пакетный замер не реализован: скорость меряется только на активном
        # прокси клиента. Честное сообщение вместо ложного отчёта об успехе.
        self._bulk_speed_busy = False
        _notify(
            "info",
            "Пакетный замер недоступен, используйте одиночный: включите нужный прокси и нажмите «Проверить скорость».",
        )
