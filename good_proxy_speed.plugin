def _parse_semver(v_str):
    parts = []
    for part in re.split(r"[^\d]+", str(v_str or "").strip()):
        if part.isdigit():
            parts.append(int(part))
    return tuple(parts) or (0, 0, 0)



def _log(msg):
    _android_log(f"[GoodProxySpeed] {msg}")


def _shared_config():
    return jclass("org.telegram.messenger.SharedConfig")


def _get_proxy_controller():
    for name in (
        "com.exteragram.messenger.proxy.ProxyController",
        "org.telegram.messenger.ProxyController",
    ):
        try:
            cls = jclass(name)
            inst = getattr(cls, "getInstance", None)
            if callable(inst):
                return inst()
        except Exception:
            continue
    return None


def _get_proxy_list(SC, proxy_controller=None):
    if proxy_controller is not None:
        try:
            getter = getattr(proxy_controller, "getProxyList", None)
            if callable(getter):
                res = getter()
                if res is not None:
                    return res
        except Exception:
            pass
    try:
        return getattr(SC, "proxyList", None) or get_private_field(SC, "proxyList")
    except Exception:
        return None


def _proxy_list_size(proxy_list):
    if proxy_list is None:
        return None
    try:
        size_fn = getattr(proxy_list, "size", None)
        if callable(size_fn):
            return int(size_fn())
    except Exception:
        pass
    try:
        return len(proxy_list)
    except Exception:
        return None


def _proxy_list_item(proxy_list, index):
    try:
        get_fn = getattr(proxy_list, "get", None)
        if callable(get_fn):
            return get_fn(int(index))
    except Exception:
        pass
    try:
        return proxy_list[int(index)]
    except Exception:
        return None


def _notify(kind, text):
    msg = str(text or "")
    if kind == "error":
        BulletinHelper.show_error(msg)
    elif kind == "success":
        BulletinHelper.show_success(msg)
    else:
        BulletinHelper.show_info(msg)


def _show_modal_alert(title, message, button_text="Понятно"):
    def _show():
        try:
            from ui.alert import AlertDialogBuilder
            fragment = get_last_fragment()
            context = fragment.getParentActivity() if fragment is not None else None
            if context is None:
                raise RuntimeError("Activity unavailable")
            builder = AlertDialogBuilder(context)
            builder.set_title(str(title))
            builder.set_message(str(message))
            builder.set_positive_button(str(button_text), lambda d, _w: d.dismiss())
            builder.show()
        except Exception:
            _notify("info", f"{title}\n\n{message}")
    run_on_ui_thread(_show)


def _format_speed_mbps(total_bytes, elapsed):
    seconds = max(0.001, float(elapsed or 0.001))
    speed_mbps = max(0.0, float(total_bytes or 0)) / seconds / 1_000_000.0
    if speed_mbps < 1.0:
        label = f"{speed_mbps:.1f} МБ/с"
    else:
        label = f"{speed_mbps:.2f} МБ/с"
    return speed_mbps, label


_PROXY_SPEED_NAME_PREFIX_RE = re.compile(r"^\s*\d+(?:[.,]\d+)?\s*МБ/с\s*[·|—-]\s*", re.IGNORECASE)
_PROXY_SPEED_NAME_ONLY_RE = re.compile(r"^\s*\d+(?:[.,]\d+)?\s*МБ/с\s*$", re.IGNORECASE)


def _proxy_speed_name_text(current_name, display_name, host, port, speed_text):
    base_name = ""
    for candidate in (current_name, display_name):
        base = str(candidate or "").strip()
        base = _PROXY_SPEED_NAME_PREFIX_RE.sub("", base, count=1).strip()
        if base and not _PROXY_SPEED_NAME_ONLY_RE.fullmatch(base):
            base_name = base
            break
    if not base_name:
        safe_host = str(host or "").strip()
        try:
            port_value = int(port or 0)
        except Exception:
            port_value = 0
        base_name = f"{safe_host}:{port_value}" if safe_host and port_value > 0 else safe_host
    speed = str(speed_text or "").strip()
    return f"{speed} · {base_name}" if speed and base_name else speed or base_name


def _parse_speed_message_id(value):
    text = str(value or "").strip()
    try:
        query = parse_qs(urlparse(text).query)
        for name in ("message_id", "msg_id"):
            for candidate in query.get(name, []):
                if str(candidate).strip().isdigit() and int(candidate) > 0:
                    return int(candidate)
    except Exception:
        pass
    path = text.split("?", 1)[0].rstrip("/")
    match = re.search(r"(\d+)\s*$", path)
    if not match:
        return 0
    try:
        result = int(match.group(1))
        return result if result > 0 else 0
    except Exception:
        return 0


def _speed_file_chunks(requested_bytes, file_size, chunk_bytes=512 * 1024):
    try:
        target = min(max(0, int(requested_bytes)), max(0, int(file_size)))
        chunk = max(1, int(chunk_bytes))
    except Exception:
        return 0, []
    return target, list(range(0, target, chunk))


def _proxy_key(host, port, secret="", proxy_type="mtproto"):
    p_type = str(proxy_type or "mtproto").lower()
    if p_type == "web" or int(port or 0) == 0:
        return f"web:{str(host or '').strip().lower()}:{str(secret or '').strip()}"
    return f"mtproto:{str(host or '').strip().lower()}:{int(port)}:{str(secret or '').strip()}"


def _proxy_item_values(item):
    if item is None:
        return "", 0, "", ""
    settings = None
    try:
        settings = get_private_field(item, "settings") or getattr(item, "settings", None)
    except Exception:
        pass

    def get_val(method_name, field_name, default=""):
        target = settings if settings is not None else item
        try:
            m = getattr(target, method_name, None)
            if callable(m):
                return m()
        except Exception:
            pass
        try:
            val = getattr(target, field_name, None)
            if val is not None:
                return val
        except Exception:
            pass
        try:
            val = get_private_field(target, field_name)
            if val is not None:
                return val
        except Exception:
            pass
        return default

    try:
        p_type = str(get_val("getType", "type", "") or "").split(".")[-1].upper()
        addr = str(get_val("getAddress", "address", "") or "").strip()
        port = int(get_val("getPort", "port", 0) or 0)
        secret = str(get_val("getSecret", "secret", "") or "").strip()
        return addr, port, secret, p_type
    except Exception:
        return "", 0, "", ""


def _proxy_settings_for_item(item, host, port, secret, proxy_type):
    try:
        settings = get_private_field(item, "settings") or getattr(item, "settings", None)
        if settings is not None:
            return settings
    except Exception:
        pass
    type_name = str(proxy_type or "").split(".")[-1].upper()
    if type_name not in ("MTPROTO", "SOCKS5", "WEB"):
        type_name = "MTPROTO" if str(secret or "").strip() else "SOCKS5"
    try:
        ProxySettings = jclass("org.telegram.utils.proxy.ProxySettings")
        ProxyType = jclass("org.telegram.utils.proxy.ProxySettings$Type")
        builder = ProxySettings.builder()
        builder.setType(getattr(ProxyType, type_name))
        builder.setAddress(str(host))
        builder.setPort(int(port))
        if type_name in ("MTPROTO", "WEB"):
            builder.setSecret(str(secret or ""))
        return builder.build()
    except Exception:
        return None


def _proxy_settings_fields(settings):
    if settings is None:
        return None
    try:
        p_type = str(getattr(settings, "getType", lambda: "")() or "").split(".")[-1].upper()
        addr = str(getattr(settings, "getAddress", lambda: "")() or "").strip()
        port = int(getattr(settings, "getPort", lambda: 0)() or 0)
        secret = str(getattr(settings, "getSecret", lambda: "")() or "").strip()
        return {"type": p_type, "address": addr, "port": port, "secret": secret}
    except Exception:
        return None


