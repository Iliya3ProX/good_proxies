import ipaddress
import json
import os
import socket
import threading
import time
import urllib.request
from urllib.parse import parse_qs, urlparse
from android_utils import OnClickListener, log, run_on_ui_thread
from base_plugin import BasePlugin, MenuItemData, MenuItemType, MethodHook
from client_utils import PLUGINS_QUEUE, get_last_fragment, get_user_config, run_on_queue, send_message
from hook_utils import find_class, get_private_field
from ui.bulletin import BulletinHelper
from java import dynamic_proxy, jclass
from java.lang import Integer
from org.telegram.tgnet import TLRPC

__id__ = "good_proxy"
__name__ = "Good Proxy"
__description__ = "Добавляет кнопку получения проверенных MTProto-прокси в меню прокси, экспорт в Избранное и действие замера скорости текущего прокси на кнопке поиска."
__author__ = "@MouXoziain"
__version__ = "1.5.0"
__min_version__ = "12.1.1"
__icon__ = "OliverEmoji/21"

PROXIES_URLS = [
    "https://cdn.jsdelivr.net/gh/Iliya3ProX/good_proxies@main/proxies.txt",
    "https://fastly.jsdelivr.net/gh/Iliya3ProX/good_proxies@main/proxies.txt",
    "https://raw.githubusercontent.com/Iliya3ProX/good_proxies/main/proxies.txt",
]

def _shared_config():
    return jclass("org.telegram.messenger.SharedConfig")

def _parse_proxy(line):
    if not (line := line.strip()) or not line.startswith("tg://proxy"): return None
    try:
        u = urlparse(line)
        p = parse_qs(u.query)
        host, port = p.get("server", [None])[0], p.get("port", [None])[0]
        if host and port:
            speed = ""
            if u.fragment:
                speed = u.fragment.replace("⚡", "").replace("MBs", " МБ/с").replace("Mbs", " МБ/с").strip()
            return {
                "host": host,
                "port": int(port),
                "secret": p.get("secret", [""])[0],
                "speed": speed
            }
    except Exception: pass
    return None

def _apply_icon(cell, tv_name, icon_name):
    try:
        tv = get_private_field(cell, tv_name)
        ctx = cell.getContext()
        res_id = ctx.getResources().getIdentifier(icon_name, "drawable", ctx.getPackageName())
        if not tv or not res_id: return
        Theme = jclass("org.telegram.ui.ActionBar.Theme")
        drawable = ctx.getResources().getDrawable(res_id).mutate()
        drawable.setColorFilter(jclass("android.graphics.PorterDuffColorFilter")(
            Theme.getColor(Theme.key_windowBackgroundWhiteGrayIcon), 
            jclass("android.graphics.PorterDuff").Mode.MULTIPLY
        ))
        is_rtl = jclass("org.telegram.messenger.LocaleController").isRTL
        tv.setCompoundDrawablesWithIntrinsicBounds(None, None, drawable, None) if is_rtl else tv.setCompoundDrawablesWithIntrinsicBounds(drawable, None, None, None)
        tv.setCompoundDrawablePadding(jclass("org.telegram.messenger.AndroidUtilities").dp(16))
    except: pass

def _unwrap_class(cls_obj):
    if cls_obj is None:
        return None
    if hasattr(cls_obj, "getName"):
        try:
            if str(cls_obj.getName()) != "java.lang.Class":
                return cls_obj
        except Exception:
            pass
    if hasattr(cls_obj, "getClass"):
        try:
            jc = cls_obj.getClass()
            if hasattr(jc, "getName") and str(jc.getName()) != "java.lang.Class":
                return jc
        except Exception:
            pass
    return cls_obj

def _resolve_class(name):
    cls = None
    try:
        cls = find_class(name)
    except Exception:
        pass
    if cls is None:
        try:
            cls = jclass("java.lang.Class").forName(name)
        except Exception:
            pass
    if cls is None:
        try:
            cls = jclass(name)
        except Exception:
            pass
    return _unwrap_class(cls)

class ProxyManagerPlugin(BasePlugin):
    def on_plugin_load(self):
        self._speed_cache = {}
        self._load_speed_cache()
        plugin = self

        # ── Быстрое действие на кнопке поиска и в боковом меню ──
        try:
            self.add_menu_item(MenuItemData(
                menu_type=MenuItemType.MAIN_MENU,
                text="Скорость текущего прокси",
                on_click=self._on_check_current_proxy_speed,
                icon="msg2_speed",
                priority=100,
            ))
        except Exception as e:
            log(f"[GoodProxy] add MAIN_MENU item error: {e}")

        try:
            self.add_menu_item(MenuItemData(
                menu_type=MenuItemType.DRAWER_MENU,
                text="Скорость текущего прокси",
                on_click=self._on_check_current_proxy_speed,
                icon="msg2_speed",
                priority=100,
            ))
        except Exception as e:
            log(f"[GoodProxy] add DRAWER_MENU item error: {e}")

        # ── Хуки на активность списка прокси ──
        ActivityCls = _resolve_class("org.telegram.ui.ProxyListActivity")
        if not ActivityCls:
            return log("[GoodProxy] ProxyListActivity not found")

        # Кнопка обновления в верхнем меню (ActionBar)
        class ActionBarHook(MethodHook):
            def after_hooked_method(self, param):
                act = param.thisObject
                try:
                    ab = get_private_field(act, "actionBar")
                    if not ab: return
                    menu = ab.createMenu()
                    MENU_IMPORT_ID = 999_888
                    if menu.getItem(MENU_IMPORT_ID) is None:
                        ctx = act.getParentActivity() or getattr(act, "getContext", lambda: None)()
                        if ctx:
                            res_id = ctx.getResources().getIdentifier("msg_download", "drawable", ctx.getPackageName())
                            iw = jclass("org.telegram.messenger.AndroidUtilities").dp(40)
                            it = menu.addItemWithWidth(MENU_IMPORT_ID, res_id, iw, "Обновить Good Proxy")
                            it.setOnClickListener(OnClickListener(lambda _v: plugin._fetch_proxies()))
                except Exception as e:
                    log(f"[GoodProxy] actionBar add error: {e}")

        # Хук клика на элементы списка (если добавлены кнопки внизу)
        class ClickHook(MethodHook):
            def after_hooked_method(self, param):
                act = param.thisObject
                try:
                    lv = get_private_field(act, "listView")
                    old_l = get_private_field(lv, "onItemClickListener")
                    if old_l and "PMClickListener" in str(old_l.getClass().getName()): return
                    class PMClickListener(dynamic_proxy(jclass("org.telegram.ui.Components.RecyclerListView$OnItemClickListener"))):
                        def __init__(self): super().__init__()
                        def onItemClick(self, view, pos):
                            orig = int(get_private_field(act, "rowCount"))
                            if pos < orig: return old_l.onItemClick(view, pos) if old_l else None
                            if pos - orig == 1: plugin._fetch_proxies()
                            elif pos - orig == 2: plugin._export_proxies()
                    lv.setOnItemClickListener(PMClickListener())
                except Exception: pass

        for m in ActivityCls.getDeclaredMethods():
            if m.getName() == "createView":
                self.hook_method(m, ActionBarHook())
                self.hook_method(m, ClickHook())

        # Хуки на адаптер (кнопки внизу списка)
        AdapterCls = _resolve_class("org.telegram.ui.ProxyListActivity$ListAdapter")
        if AdapterCls:
            def _get_orig_count(param):
                act = get_private_field(param.thisObject, "this$0")
                return int(get_private_field(act, "rowCount")) if act else None

            class CountHook(MethodHook):
                def after_hooked_method(self, param):
                    param.setResult(Integer(int(param.getResult()) + 3))

            class ViewTypeHook(MethodHook):
                def before_hooked_method(self, param):
                    if (orig := _get_orig_count(param)) is not None and (pos := int(param.args[0])) >= orig:
                        param.setResult(Integer(0 if pos - orig == 0 else 1))

            class BindHook(MethodHook):
                def before_hooked_method(self, param):
                    if (orig := _get_orig_count(param)) is not None and int(param.args[1]) >= orig:
                        param.setResult(None)
                def after_hooked_method(self, param):
                    if (orig := _get_orig_count(param)) is None or (pos := int(param.args[1])) < orig: return
                    cell, cpos = param.args[0].itemView, pos - orig
                    try:
                        if cpos == 1:
                            cell.setText("Получить новый список", True)
                            _apply_icon(cell, "textView", "msg_download")
                        elif cpos == 2:
                            cell.setText("Экспортировать прокси", False)
                            _apply_icon(cell, "textView", "msg_share")
                    except Exception: pass

            for m in AdapterCls.getDeclaredMethods():
                if m.getName() == "getItemCount": self.hook_method(m, CountHook())
                elif m.getName() == "getItemViewType": self.hook_method(m, ViewTypeHook())
                elif m.getName() == "onBindViewHolder" and len(m.getParameterTypes()) == 2: self.hook_method(m, BindHook())

    def _on_check_current_proxy_speed(self, context=None):
        BulletinHelper.show_info("Замеряем скорость прокси (тест 1 МБ)…")
        run_on_queue(self._do_check_current_speed, PLUGINS_QUEUE)

    def _do_check_current_speed(self):
        try:
            SC = _shared_config()
            is_enabled = getattr(SC, "proxyEnabled", False) or (hasattr(SC, "isProxyEnabled") and SC.isProxyEnabled())
            if not is_enabled:
                return run_on_ui_thread(lambda: BulletinHelper.show_info("Прокси сейчас отключен."))

            cp = getattr(SC, "currentProxy", None)
            if not cp:
                return run_on_ui_thread(lambda: BulletinHelper.show_info("Нет активного прокси."))

            host = str(getattr(cp, "address", ""))
            port = int(getattr(cp, "port", 0))

            if not host or not port:
                return run_on_ui_thread(lambda: BulletinHelper.show_error("Неверные параметры прокси."))

            # 1. Быстрый сокетный замер пинга (RTT)
            ping_ms = -1
            try:
                t0 = time.monotonic()
                sock = socket.create_connection((host, port), timeout=3)
                ping_ms = int((time.monotonic() - t0) * 1000)
                sock.close()
            except Exception:
                pass

            # 2. Живой замер скорости скачивания через MTProto (пакетный тест ~1 МБ)
            speed_str = None
            try:
                UserConfig = jclass("org.telegram.messenger.UserConfig")
                ConnectionsManager = jclass("org.telegram.tgnet.ConnectionsManager")
                TLRPC = jclass("org.telegram.tgnet.TLRPC")
                RequestDelegate = jclass("org.telegram.tgnet.RequestDelegate")

                cm = ConnectionsManager.getInstance(UserConfig.selectedAccount)

                target_count = 12  # 12 * ~85 КБ ≈ 1.02 МБ
                completed = [0]
                total_bytes = [0]
                done_event = threading.Event()
                lock = threading.Lock()
                t_start = time.monotonic()

                class BatchSpeedDelegate(dynamic_proxy(RequestDelegate)):
                    def run(self, response, error):
                        with lock:
                            if response is not None:
                                try:
                                    sz = len(response.serialize())
                                except Exception:
                                    sz = 85000
                                total_bytes[0] += sz
                            completed[0] += 1
                            if completed[0] >= target_count:
                                done_event.set()

                del_inst = BatchSpeedDelegate()
                for _ in range(target_count):
                    cm.sendRequest(TLRPC.TL_help_getCountriesList(), del_inst, 2)

                # Ожидание загрузки 1 МБ данных (до 8 секунд)
                done_event.wait(timeout=8.0)

                elapsed = max(0.001, time.monotonic() - t_start)
                if total_bytes[0] >= 100000:
                    kbs = (total_bytes[0] / 1024.0) / elapsed
                    if kbs >= 1024:
                        speed_str = f"{kbs / 1024.0:.2f} МБ/с"
                    else:
                        speed_str = f"{kbs:.0f} КБ/с"
            except Exception as e:
                log(f"[GoodProxy] CM 1MB speed test err: {e}")

            if speed_str:
                ping_part = f"Пинг: {ping_ms} мс · " if ping_ms > 0 else ""
                res = f"⚡ Скорость: {speed_str} (1 МБ)\n{ping_part}{host}:{port}"
                return run_on_ui_thread(lambda: BulletinHelper.show_success(res))

            # Фолбэк на кэшированную скорость или пинг
            cached_speed = self._get_proxy_speed(host, port)
            if cached_speed:
                ping_part = f"Пинг: {ping_ms} мс · " if ping_ms > 0 else ""
                res = f"⚡ Скорость: {cached_speed}\n{ping_part}{host}:{port}"
                return run_on_ui_thread(lambda: BulletinHelper.show_success(res))

            if ping_ms > 0:
                res = f"⚡ Пинг: {ping_ms} мс\n{host}:{port} (онлайн)"
                return run_on_ui_thread(lambda: BulletinHelper.show_success(res))

            run_on_ui_thread(lambda: BulletinHelper.show_error(f"Прокси {host}:{port} не отвечает."))
        except Exception as e:
            log(f"[GoodProxy] check speed error: {e}")
            run_on_ui_thread(lambda: BulletinHelper.show_error(f"Сбой замера: {e}"))

    def _get_cache_dir(self):
        try:
            from file_utils import get_plugins_dir
            p_dir = get_plugins_dir()
            if p_dir: return str(p_dir)
        except Exception: pass
        try:
            ctx = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
            if ctx: return str(ctx.getFilesDir().getAbsolutePath())
        except Exception: pass
        return "."

    def _load_speed_cache(self):
        try:
            cache_file = os.path.join(self._get_cache_dir(), "good_proxy_speeds.json")
            if os.path.exists(cache_file):
                with open(cache_file, "r", encoding="utf-8") as f:
                    self._speed_cache = json.load(f)
                    return
        except Exception as e:
            log(f"[GoodProxy] load cache error: {e}")
        self._speed_cache = getattr(self, "_speed_cache", {})

    def _save_speed_cache(self):
        try:
            cache_file = os.path.join(self._get_cache_dir(), "good_proxy_speeds.json")
            with open(cache_file, "w", encoding="utf-8") as f:
                json.dump(self._speed_cache, f, ensure_ascii=False)
        except Exception as e:
            log(f"[GoodProxy] save cache error: {e}")

    def _get_proxy_speed(self, host, port):
        if not hasattr(self, "_speed_cache") or not self._speed_cache:
            self._load_speed_cache()
        sp = self._speed_cache.get(f"{host}:{port}")
        if sp: return sp
        return self._speed_cache.get(str(host), "")

    def _fetch_proxies(self):
        BulletinHelper.show_info("Загружаем список прокси…")
        run_on_queue(self._do_fetch, PLUGINS_QUEUE)

    def _do_fetch(self):
        raw = None
        for url in PROXIES_URLS:
            try:
                req = urllib.request.Request(
                    url,
                    headers={"User-Agent": "Mozilla/5.0 (Linux; Android 10; Mobile) AppleWebKit/537.36"}
                )
                with urllib.request.urlopen(req, timeout=10) as resp:
                    raw = resp.read().decode("utf-8", errors="replace")
                    break
            except Exception:
                pass

        if not raw:
            return run_on_ui_thread(lambda: BulletinHelper.show_error("Ошибка загрузки: проверьте подключение."))

        parsed = {f"{p['host']}:{p['port']}:{p.get('secret', '')}": p for l in raw.splitlines() if (p := _parse_proxy(l))}
        SC = _shared_config()
        try:
            SC.loadProxyList()
            existing = {f"{p.address}:{p.port}:{p.secret or ''}" for i in range(SC.proxyList.size()) if (p := SC.proxyList.get(i))}
        except Exception:
            existing = set()

        added = duplicates = 0
        ProxyInfo = jclass("org.telegram.messenger.SharedConfig$ProxyInfo")
        for key, p in parsed.items():
            if p.get("speed"):
                self._speed_cache[f"{p['host']}:{p['port']}"] = p["speed"]
                self._speed_cache[p['host']] = p["speed"]
            if key in existing:
                duplicates += 1
                continue
            try:
                SC.addProxy(ProxyInfo(str(p["host"]), int(p["port"]), "", "", str(p.get("secret", "") or "")))
                existing.add(key)
                added += 1
            except Exception as e:
                log(f"[GoodProxy] addProxy error: {e}")

        self._save_speed_cache()

        try:
            SC.saveProxyList()
        except Exception:
            pass

        # 1. Отправляем системное уведомление ядру Telegram об изменении списка
        try:
            NC = jclass("org.telegram.messenger.NotificationCenter")
            NC.getGlobalInstance().postNotificationName(NC.proxySettingsChanged)
        except Exception as e:
            log(f"[GoodProxy] notify proxySettingsChanged error: {e}")

        # 2. Мгновенно перерисовываем активный экран списка прокси
        def _refresh_ui():
            try:
                frag = get_last_fragment()
                if frag is not None:
                    for meth in ("updateRows",):
                        m = getattr(frag, meth, None)
                        if callable(m):
                            try: m(True)
                            except Exception:
                                try: m()
                                except Exception: pass
                    for attr in ("listAdapter", "adapter"):
                        ad = get_private_field(frag, attr)
                        if ad is not None and hasattr(ad, "notifyDataSetChanged"):
                            ad.notifyDataSetChanged()
                            break
            except Exception as e:
                log(f"[GoodProxy] UI refresh error: {e}")

        run_on_ui_thread(_refresh_ui)

        run_on_ui_thread(lambda: BulletinHelper.show_success(f"Добавлено: {added}. Уже было: {duplicates}."))

    def _export_proxies(self):
        run_on_queue(self._do_export, PLUGINS_QUEUE)

    def _do_export(self):
        try:
            SC = _shared_config()
            SC.loadProxyList()
            if not SC.proxyList or SC.proxyList.size() == 0:
                return run_on_ui_thread(lambda: BulletinHelper.show_info("Нет прокси для экспорта."))
            proxies = []
            for i in range(SC.proxyList.size()):
                p = SC.proxyList.get(i)
                proxies.append({"host": str(p.address), "port": int(p.port), "secret": str(p.secret) if p.secret else ""})
            def sort_key(p):
                try: h_val = (0, ipaddress.ip_address(p['host']).version, ipaddress.ip_address(p['host']))
                except ValueError: h_val = (1, 0, p['host'])
                return (h_val, p['port'], len(p['secret']), p['secret'])
            
            lines = []
            for p in sorted(proxies, key=sort_key):
                speed = self._get_proxy_speed(p['host'], p['port'])
                speed_tag = f"#⚡{speed.replace(' ', '')}" if speed else ""
                lines.append(f"tg://proxy?server={p['host']}&port={p['port']}&secret={p['secret']}{speed_tag}")

            if not lines: return run_on_ui_thread(lambda: BulletinHelper.show_error("Не удалось сформировать список."))
            txt = "\n".join(lines)
            q = TLRPC.TL_messageEntityBlockquote()
            q.collapsed, q.offset, q.length = True, 0, len(txt.encode("utf-16-le")) // 2
            send_message({"peer": get_user_config().getClientUserId(), "message": txt, "entities": [q]})
            run_on_ui_thread(lambda: BulletinHelper.show_success(f"Экспортировано {len(lines)} прокси в Избранное."))
        except Exception as e:
            log(f"[PS] export error: {e}")
            run_on_ui_thread(lambda: BulletinHelper.show_error(f"Ошибка экспорта: {e}"))