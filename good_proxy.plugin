def _copy_to_clipboard(text, label="GoodProxy_Proxies"):
    """Копирует текст в буфер обмена Android (через AndroidUtilities или ClipboardManager)."""
    try:
        from org.telegram.messenger import AndroidUtilities
        AndroidUtilities.addToClipboard(text)
        return True
    except Exception as e:
        _log(f"AndroidUtilities.addToClipboard error: {e}")
    try:
        from org.telegram.messenger import ApplicationLoader
        from android.content import ClipData, Context
        context = ApplicationLoader.applicationContext
        if context:
            clipboard = context.getSystemService(Context.CLIPBOARD_SERVICE)
            clip = ClipData.newPlainText(label, text)
            clipboard.setPrimaryClip(clip)
            return True
    except Exception as e:
        _log(f"ClipboardManager fallback error: {e}")
    return False


def _parse_semver(v_str):
    """Парсит semver-строку в кортеж чисел для корректного сравнения версий."""
    parts = []
    for part in re.split(r"[^\d]+", str(v_str or "").strip()):
        if part.isdigit():
            parts.append(int(part))
    return tuple(parts) or (0, 0, 0)



def _log(msg):
    try:
        log(f"[GoodProxy] {msg}")
    except Exception:
        pass


def _shared_config():
    return jclass("org.telegram.messenger.SharedConfig")


def _show_modal_alert(title, message, button_text="Закрыть"):
    """Show a non-dismissible-until-button alert; caller must run on the UI thread."""
    try:
        from ui.alert import AlertDialogBuilder
        fragment = get_last_fragment()
        context = fragment.getParentActivity() if fragment is not None else None
        if context is None:
            return False
        builder = AlertDialogBuilder(context)
        builder.set_title(str(title or "Good Proxy"))
        builder.set_message(str(message or ""))
        builder.set_positive_button(
            str(button_text or "Закрыть"),
            lambda dialog, _which: dialog.dismiss(),
        )
        builder.create()
        builder.set_cancelable(False)
        builder.set_canceled_on_touch_outside(False)
        builder.show()
        return True
    except Exception as e:
        _log(f"modal alert failed: {type(e).__name__}")
        return False


def _notify(kind, message):
    """Show local UI only; errors use a modal that stays until its close button is pressed."""
    detail = str(message or "")
    if str(kind or "").lower() == "error":
        max_chars = 6000
        if len(detail) > max_chars:
            detail = detail[:max_chars].rstrip() + "\n\nТекст сокращён; подробный отчёт см. в «Избранном»."

        def _show_error():
            if _show_modal_alert("Good Proxy — ошибка", detail, "Закрыть"):
                return
            _log("No Activity for modal error alert; showing fallback bulletin")
            method = getattr(BulletinHelper, "show_error", None)
            if callable(method):
                try:
                    method(detail[:1000])
                except Exception:
                    pass
        run_on_ui_thread(_show_error)
        return True

    method = getattr(BulletinHelper, f"show_{kind}", None)
    if callable(method):
        run_on_ui_thread(lambda m=method, text=detail: m(text))
    else:
        _log(f"Unknown bulletin kind: {kind}")
    return True


def _format_speed_mbps(total_bytes, elapsed):
    """Return decimal MB/s and a concise label, rounding sub-1000 KB/s to tenths."""
    seconds = max(0.001, float(elapsed or 0.001))
    speed_mbps = max(0.0, float(total_bytes or 0)) / seconds / 1_000_000.0
    if speed_mbps < 1.0:
        label = f"{speed_mbps:.1f} МБ/с"
    else:
        label = f"{speed_mbps:.2f} МБ/с"
    return speed_mbps, label


_PROXY_SPEED_NAME_PREFIX_RE = re.compile(r"^\s*\d+(?:[.,]\d+)?\s*МБ/с\s*[·|—-]\s*", re.IGNORECASE)
_PROXY_SPEED_NAME_ONLY_RE = re.compile(r"^\s*\d+(?:[.,]\d+)?\s*МБ/с\s*$", re.IGNORECASE)


def _proxy_speed_name_text(current_name, display_name, host, port, speed_text):
    """Prefix the latest speed while preserving the underlying proxy label."""
    base_name = ""
    for candidate in (current_name, display_name):
        base = str(candidate or "").strip()
        base = _PROXY_SPEED_NAME_PREFIX_RE.sub("", base, count=1).strip()
        if base and not _PROXY_SPEED_NAME_ONLY_RE.fullmatch(base):
            base_name = base
            break
    if not base_name:
        safe_host = _safe_proxy_log_host(host)
        try:
            port_value = int(port or 0)
        except Exception:
            port_value = 0
        base_name = f"{safe_host}:{port_value}" if safe_host and port_value > 0 else safe_host
    speed = str(speed_text or "").strip()
    return f"{speed} · {base_name}" if speed and base_name else speed or base_name


def _proxy_connection_link(host, port, settings=None, proxy_type="", secret=""):
    """Build a shareable Telegram link; credentials are included only in this requested link."""
    fields = _proxy_settings_fields(settings) or {}
    kind = str(fields.get("type") or proxy_type or "").split(".")[-1].upper()
    secret_value = str(fields.get("secret", "") or secret or "")
    if not kind:
        kind = "MTPROTO" if secret_value else "SOCKS5"
    server = str(host or fields.get("address", "")).strip()
    port_value = int(port or fields.get("port", 0) or 0)
    if not server or port_value <= 0:
        return ""
    params = {"server": server, "port": port_value}
    if kind == "SOCKS5":
        username = str(fields.get("username", "") or "")
        password = str(fields.get("password", "") or "")
        if username:
            params["user"] = username
        if password:
            params["pass"] = password
        return "https://t.me/socks?" + urlencode(params)
    if kind != "MTPROTO" or not secret_value:
        return ""
    params["secret"] = secret_value
    return "https://t.me/proxy?" + urlencode(params)


